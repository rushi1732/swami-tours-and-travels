# Swami Tours & Travels — Environment Variables Configuration
# Copy this file to .env and configure your secret credentials

# GEMINI_API_KEY:
# Required for live server-side AI chatbot conversational queries.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If left blank or unset, the chatbot will run in direct rule-based booking concierge mode.
GEMINI_API_KEY="your-gemini-api-key-here"

# WHATSAPP_NUMBER:
# Official business WhatsApp number for Swami Tours & Travels (country code + 10 digits without symbols).
# Default verified number: 917083808483 (+91 70838 08483)
WHATSAPP_NUMBER="917083808483"

# PORT:
# Optional port for the standalone Express production server (defaults to 3000)
PORT=3000
